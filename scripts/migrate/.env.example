WP_URL="https://deine-domain.ch"
MIGRATE_TOKEN="derselbe-token-wie-in-wp-config"

# Nur für download.sh media-Backup (Löschen/Neuanlegen von Medien via
# core /wp/v2/media braucht echte WP-Auth, der Migrate-Token gilt nur für
# die drei czemp/v1/* Routen). Anlegen unter WP-Admin → Benutzer → Profil
# → "Anwendungspasswörter" → Name z.B. "migrate-backup" → Passwort erzeugen
# und hier 1:1 mit Leerzeichen einfügen. Nach der Migration wieder löschen.
WP_USER="admin-benutzername"
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"